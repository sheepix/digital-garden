---
// src/components/MarkdownContent.astro
// Starlight MarkdownContent 覆写：正文之后追加标签贴纸与反向链接区块。
// 标签、标题从 Starlight 路由上下文读取（Starlight 0.37 不再向该组件透传 frontmatter）。
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import Backlinks from './Backlinks.astro';
import PageTags from './PageTags.astro';

const route = (Astro.locals as any).starlightRoute;
const entryData = route?.entry?.data ?? {};
const entryId = (route?.entry?.id ?? '').replace(/\.mdx?$/, '');

const pageTags: string[] = Array.isArray(entryData.tags)
  ? entryData.tags.map((tag: unknown) => String(tag))
  : [];
const pageTitle = entryData.title ? String(entryData.title) : '';

const slug = entryId || Astro.url.pathname.replace(/^\/+/, '').replace(/\/+$/, '');
const isIndexPage = entryId === '' || entryId === 'index' || entryId === 'splash';
---

<Default {...Astro.props}>
  <slot />

  {pageTags.length > 0 && <PageTags tags={pageTags} />}
</Default>

{!isIndexPage && <Backlinks slug={slug} title={pageTitle} />}
