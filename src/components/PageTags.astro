---
// src/components/PageTags.astro
// 便签风格的标签胶囊，点击跳到标签索引页对应锚点。
interface Props {
  tags?: string[];
}

const { tags = [] } = Astro.props;

const anchorOf = (tag: string) =>
  tag
    .trim()
    .toLowerCase()
    .replace(/\s+/g, '-');
---

{
  tags.length > 0 && (
    <div class="page-tags">
      <span class="page-tags-label">贴纸</span>
      {tags.map((tag) => (
        <a class="page-tag" href={`/tags/#${anchorOf(tag)}`}>
          #{tag}
        </a>
      ))}
    </div>
  )
}
