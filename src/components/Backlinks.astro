---
// src/components/Backlinks.astro
// 构建时从内容集合实时计算反向链接：扫描每篇笔记正文里的 [[wikilink]]，
// 按标题或文件名匹配到当前页面，避免依赖可能过期的静态 JSON。
import { getCollection } from 'astro:content';

interface Props {
  slug?: string;
  title?: string;
}

const { slug = '', title = '' } = Astro.props;

const entries = await getCollection('docs');

const normalize = (value: string) =>
  value
    .trim()
    .toLowerCase()
    .replace(/\.mdx?$/, '')
    .replace(/[\s_]+/g, '-');

const stripSlash = (value: string) => value.replace(/^\/+/, '').replace(/\/+$/, '');

const pageSlug = stripSlash(slug);
const pageTitle = title.trim().toLowerCase();

// 归一化到「slug」的映射表：slug 与标题都能命中同一篇笔记
const resolveTarget = (raw: string) => {
  const target = raw.trim();
  const lowered = target.toLowerCase();
  for (const entry of entries) {
    const entrySlug = entry.id.replace(/\.mdx?$/, '');
    const entryTitle = (entry.data.title ?? '').toString();
    if (entrySlug.toLowerCase() === lowered || entryTitle.toLowerCase() === lowered) return entrySlug;
    if (normalize(entrySlug) === normalize(target) || normalize(entryTitle) === normalize(target)) return entrySlug;
  }
  return null;
};

interface BackRef {
  slug: string;
  title: string;
}

const backlinks: BackRef[] = [];

for (const entry of entries) {
  const entrySlug = entry.id.replace(/\.mdx?$/, '');
  const body = entry.body ?? '';
  const matchesCurrent = pageTitle
    ? entrySlug.toLowerCase() === pageSlug.toLowerCase() || (entry.data.title ?? '').toString().toLowerCase() === pageTitle
    : entrySlug.toLowerCase() === pageSlug.toLowerCase();
  if (!matchesCurrent) continue;

  for (const other of entries) {
    if (other.id === entry.id) continue;
    const otherBody = other.body ?? '';
    const links = [...otherBody.matchAll(/\[\[([^\]|#]+)(?:[|#][^\]]*)?\]\]/g)].map((m) => m[1]);
    if (links.some((link) => resolveTarget(link) === entrySlug)) {
      const otherSlug = other.id.replace(/\.mdx?$/, '');
      if (!backlinks.some((item) => item.slug === otherSlug)) {
        backlinks.push({
          slug: otherSlug,
          title: (other.data.title ?? otherSlug).toString(),
        });
      }
    }
  }
  break;
}
---

{
  backlinks.length > 0 && (
    <aside class="backlinks-section">
      <h3 class="backlinks-heading">
        这些笔记指向这里<span class="backlinks-count">{backlinks.length}</span>
      </h3>
      <ul class="backlinks-list">
        {backlinks.map((link) => (
          <li class="backlink-item">
            <a href={`/${link.slug}/`} class="backlink-link">
              <span class="backlink-pin" aria-hidden="true" />
              <span class="backlink-title">{link.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
